[sub_resource type="Shader" id="Shader_w13gh"]
code = "shader_type canvas_item;

uniform float angle_width : hint_range(0.0, 6.283); // radians, 0 to 2*PI
uniform float start_angle : hint_range(0.0, 6.283); // radians
uniform float radius : hint_range(0.0, 1.0) = 1.0;  // relative to texture size (0 to 1)

void fragment() {
    vec2 uv = UV - vec2(0.5); // center the UV at (0,0)
    
    float dist = length(uv);
    float angle = atan(uv.y, uv.x);
    
    // Normalize angle to [0, 2π)
    if (angle < 0.0) {
        angle += 6.28318530718;
    }

    float end_angle = mod(start_angle + angle_width, 6.28318530718);

    // Check if angle is within the sector
    bool in_sector = false;
    if (start_angle < end_angle) {
        in_sector = angle >= start_angle && angle <= end_angle;
    } else {
        // Sector wraps around 2π
        in_sector = angle >= start_angle || angle <= end_angle;
    }

    bool in_radius = dist <= radius;

    if (in_sector && in_radius) {
        // Erase (set alpha to 0)
        COLOR = vec4(0.0);
    } else {
        // Normal texture
        COLOR = texture(TEXTURE, UV);
    }
}
"

